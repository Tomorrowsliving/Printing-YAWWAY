[Unit]
Description=Klipper Farm Node Agent
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/node-agent
Environment=BACKEND_URL=http://YOUR_SERVER_IP
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
