[Unit]
Description=Klipper Farm Node Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/klipper-farm-control/node-agent
Environment=BACKEND_URL=http://YOUR_SERVER_IP
Environment=NODE_AGENT_DIR=/opt/klipper-farm-control/node-agent
Environment=NODE_AGENT_REPO_DIR=/opt/klipper-farm-control
ExecStart=/opt/klipper-farm-control/node-agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
