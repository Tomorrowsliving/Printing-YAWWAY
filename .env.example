# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost/klipper_farm
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@klipperfarm.local

# Storage Configuration
STORAGE_ROOT=/mnt/klipper-farm
BACKUP_PATH=/mnt/klipper-farm/backups
PRINTERS_PATH=/mnt/klipper-farm/printers

# Node Agent Default Port
AGENT_PORT=8001
