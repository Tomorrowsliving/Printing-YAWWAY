# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost/klipper_farm
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@klipperfarm.local

# Storage Configuration
STORAGE_ROOT=/mnt/klipper-farm
BACKUP_PATH=/mnt/klipper-farm/backups
PRINTERS_PATH=/mnt/klipper-farm/printers

# NFS Configuration
# Set this to the LAN IP or DNS name of the machine running the dashboard.
NFS_SERVER_HOST=YOUR_SERVER_IP
NFS_PERMITTED=*
NFS_EXPORT_PATH=/exports
NFS_CLIENT_MOUNT=/mnt/klipper-farm

# Public URL nodes and generated Moonraker configs should use to reach the dashboard.
BACKEND_PUBLIC_URL=http://YOUR_SERVER_IP

# Node Agent Default Port
AGENT_PORT=8001
