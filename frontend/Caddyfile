:80 {
    @app_shell {
        not path /api/* /ws/* /static/* /asset-manifest.json /favicon.ico /manifest.json /robots.txt /logo*
    }
    header @app_shell Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

    @static_assets path /static/*
    header @static_assets Cache-Control "public, max-age=31536000, immutable"

    handle /api/* {
        reverse_proxy backend:8001
    }

    handle /ws/* {
        reverse_proxy backend:8001
    }

    handle {
        root * /usr/share/caddy
        file_server
        try_files {path} /index.html
    }
}
